<mujoco model="g1_29dof goal tracking scene">
  <include file="g1_29dof_goal_tracking_camera.xml"/>

  <statistic center="1 0 0.5" extent="2.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Independent visual markers for the long waypoint test: start (green), path (cyan), goal (red). -->
    <geom name="goal_tracking_start_marker" type="sphere" pos="0 0 0.09" size="0.09"
      rgba="0.1 0.9 0.25 1" contype="0" conaffinity="0"/>

    <geom name="goal_tracking_path_00_01" type="capsule" fromto="0 0 0.09 1.0 0.0 0.09" size="0.04"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_path_01_02" type="capsule" fromto="1.0 0.0 0.09 2.0 0.6 0.09" size="0.04"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_path_02_03" type="capsule" fromto="2.0 0.6 0.09 3.0 -0.6 0.09" size="0.04"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_path_03_04" type="capsule" fromto="3.0 -0.6 0.09 4.0 0.7 0.09" size="0.04"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_path_04_05" type="capsule" fromto="4.0 0.7 0.09 5.0 -0.4 0.09" size="0.04"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_path_05_06" type="capsule" fromto="5.0 -0.4 0.09 6.0 0.0 0.09" size="0.04"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>

    <geom name="goal_tracking_waypoint_01" type="sphere" pos="1.0 0.0 0.17" size="0.07"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_waypoint_02" type="sphere" pos="2.0 0.6 0.17" size="0.07"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_waypoint_03" type="sphere" pos="3.0 -0.6 0.17" size="0.07"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_waypoint_04" type="sphere" pos="4.0 0.7 0.17" size="0.07"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_waypoint_05" type="sphere" pos="5.0 -0.4 0.17" size="0.07"
      rgba="0.05 0.65 1.0 1" contype="0" conaffinity="0"/>

    <geom name="goal_tracking_goal_marker" type="sphere" pos="6.0 0 0.95" size="0.16"
      rgba="1 0.1 0.05 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_goal_base" type="sphere" pos="6.0 0 0.14" size="0.14"
      rgba="1 0.1 0.05 1" contype="0" conaffinity="0"/>
    <geom name="goal_tracking_goal_pillar" type="cylinder" pos="6.0 0 0.52" size="0.04 0.52"
      rgba="1 0.1 0.05 0.85" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
